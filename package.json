{
  "name": "luma-youtube-client",
  "version": "1.0.0",
  "description": "A thoughtful desktop home for YouTube and your local video library.",
  "author": "Luma contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "compile": "node scripts/compile.mjs",
    "build": "npm run typecheck && npm run compile && electron-builder --publish never",
    "build:dir": "npm run compile && electron-builder --dir --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run compile && playwright test",
    "test:packaged": "playwright test",
    "start": "electron .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@types/youtube": "^0.1.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "org.luma.youtubeclient",
    "productName": "Luma",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EpicGamer1599/Luma.git"
  },
  "homepage": "https://github.com/EpicGamer1599/Luma#readme",
  "bugs": {
    "url": "https://github.com/EpicGamer1599/Luma/issues"
  }
}
